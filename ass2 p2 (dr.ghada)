    ("Low Dropout (0.1)",  32, 0.10, 1e-3, 1e-4, True),
    ("High LR (0.01)",     32, 0.30, 1e-2, 1e-4, True),
    ("Low LR (0.0001)",    32, 0.30, 1e-4, 1e-4, True),
    ("No BatchNorm",       32, 0.30, 1e-3, 1e-4, False),
    ("High L2 (0.01)",     32, 0.30, 1e-3, 1e-2, True),
