# 2. MODEL BUILDER
# ─────────────────────────────────────────────────────────────────────────────
def build_cnn(filters=32, dropout=0.3, lr=1e-3, l2=1e-4, batch_norm=True):
    inp = keras.Input(shape=(28, 28, 1))

    x = layers.Conv2D(filters, 3, padding="same", use_bias=False,
                      kernel_regularizer=regularizers.l2(l2))(inp)
    if batch_norm: x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)
    x = layers.Conv2D(filters, 3, padding="same", use_bias=False,
                      kernel_regularizer=regularizers.l2(l2))(x)
    if batch_norm: x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)
    x = layers.MaxPooling2D(2)(x)
    x = layers.Dropout(dropout)(x)

    x = layers.Conv2D(filters*2, 3, padding="same", use_bias=False,
                      kernel_regularizer=regularizers.l2(l2))(x)
    if batch_norm: x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)
    x = layers.Conv2D(filters*2, 3, padding="same", use_bias=False,
                      kernel_regularizer=regularizers.l2(l2))(x)
    if batch_norm: x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)
    x = layers.MaxPooling2D(2)(x)
    x = layers.Dropout(dropout)(x)

    x = layers.GlobalAveragePooling2D()(x)
    x = layers.Dense(128, activation="relu",
                     kernel_regularizer=regularizers.l2(l2))(x)
    x = layers.Dropout(dropout + 0.1)(x)
    out = layers.Dense(10, activation="softmax")(x)

    model = keras.Model(inp, out)
    model.compile(
        optimizer=keras.optimizers.Adam(learning_rate=lr),
        loss="sparse_categorical_crossentropy",
        metrics=["accuracy"]
    )
    return model

def train_model(model, epochs=15, name=""):
    print(f"  Training: {name} ...")
    train_ds = tf.data.Dataset.from_tensor_slices((X_train, y_train))
    train_ds = train_ds.shuffle(len(X_train), seed=SEED).batch(256)
    train_ds = train_ds.map(
        lambda x, y: (tf.image.random_flip_left_right(x), y),
        num_parallel_calls=tf.data.AUTOTUNE
    ).prefetch(tf.data.AUTOTUNE)

    cb = [
        EarlyStopping(monitor="val_accuracy", patience=4,
                      restore_best_weights=True, verbose=0),
        ReduceLROnPlateau(monitor="val_loss", factor=0.5,
                          patience=3, min_lr=1e-6, verbose=0),
    ]
    history = model.fit(train_ds, epochs=epochs,
                        validation_data=(X_val, y_val),
                        callbacks=cb, verbose=1)
    _, test_acc = model.evaluate(X_test, y_test, verbose=0)
    _, val_acc  = model.evaluate(X_val,  y_val,  verbose=0)
    gap = (max(history.history["accuracy"]) - max(history.history["val_accuracy"])) * 100
    print(f"    Val: {val_acc*100:.2f}%  Test: {test_acc*100:.2f}%  "
          f"Train-Val gap: {gap:.2f}%  Epochs: {len(history.history['loss'])}")
    return history, test_acc, val_acc

