    ax_inp = fig.add_subplot(gs[row, :])
    ax_inp.imshow(simg[0,:,:,0], cmap="gray", aspect="auto")
    ax_inp.set_title(f"Sample {si+1}: '{slabel}'",
                     color="#FF9800", fontsize=10, fontweight="bold", loc="left")
    ax_inp.axis("off")
    row += 1

    for li, act_model in enumerate(activation_models):
        feat_maps = act_model.predict(simg, verbose=0)
        layer_name = conv_layers[li].name

        # Label column
        ax_lbl = fig.add_subplot(gs[row, 0])
        ax_lbl.set_facecolor("#0F1117")
        ax_lbl.text(0.5, 0.5, f"{layer_name}\n({feat_maps.shape[-1]} maps)",
                    color="#4FC3F7", fontsize=7, ha="center", va="center",
                    rotation=0, transform=ax_lbl.transAxes)
        ax_lbl.axis("off")

        for fi in range(n_show):
            ax = fig.add_subplot(gs[row, fi+1])
            ax.imshow(feat_maps[0,:,:,fi], cmap="viridis")
            ax.axis("off")
        row += 1

