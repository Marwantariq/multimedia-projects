# Kaggle-Specific Dataset Splitter
def ensure_dataset_structure(source_root, writable_dir='/kaggle/working/split_data'):
    source_root = Path(source_root)
    if not source_root.exists():
        raise FileNotFoundError(f"Dataset root {source_root} not found. Check your Kaggle input path.")
    
    if (source_root / 'train').exists() and (source_root / 'val').exists() and (source_root / 'test').exists():
        print(f"Found existing split in {source_root}. Using directly.")
        return str(source_root / 'train'), str(source_root / 'val'), str(source_root / 'test')
    
    print(f"No split found in input. Creating split in writable directory: {writable_dir}...")
    working_root = Path(writable_dir)
    train_dir = working_root / 'train'
    val_dir = working_root / 'val'
    test_dir = working_root / 'test'
    
    if train_dir.exists():
        print("Split already generated in working directory. Skipping copy.")
        return str(train_dir), str(val_dir), str(test_dir)
        
    train_dir.mkdir(parents=True, exist_ok=True)
    val_dir.mkdir(parents=True, exist_ok=True)
    test_dir.mkdir(parents=True, exist_ok=True)
    
    classes = [p for p in source_root.iterdir() if p.is_dir()]
    
    for cls in classes:
        imgs = [p for p in cls.iterdir() if p.is_file()]
        if not imgs: continue
        
        random.shuffle(imgs)
        n = len(imgs)
        n_train = int(0.7 * n)
        n_val = int(0.15 * n)
        
        (train_dir / cls.name).mkdir(parents=True, exist_ok=True)
        (val_dir / cls.name).mkdir(parents=True, exist_ok=True)
        (test_dir / cls.name).mkdir(parents=True, exist_ok=True)
        
        for i, img in enumerate(imgs):
            if i < n_train:
                shutil.copy(img, train_dir / cls.name / img.name)
            elif i < n_train + n_val:
                shutil.copy(img, val_dir / cls.name / img.name)
            else:
                shutil.copy(img, test_dir / cls.name / img.name)
                
    return str(train_dir), str(val_dir), str(test_dir)

def compute_mean_std(dataset):
    loader = DataLoader(dataset, batch_size=64, num_workers=0, shuffle=False)
    mean, std, nb_samples = 0., 0., 0
    for data, _ in loader:
        batch_samples = data.size(0)
        data = data.view(batch_samples, data.size(1), -1)
        mean += data.mean(2).sum(0)
        std += data.std(2).sum(0)
        nb_samples += batch_samples
    return (mean / nb_samples).numpy().tolist(), (std / nb_samples).numpy().tolist()
