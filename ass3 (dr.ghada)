# Evaluation Helper
def evaluate_model(model, loader, device):
    model.eval()
    preds, targets, losses = [], [], []
    criterion = nn.CrossEntropyLoss()
    with torch.no_grad():
        for x, y in loader:
            x, y = x.to(device), y.to(device)
            out = model(x)
            loss = criterion(out, y)
            losses.append(loss.item() * x.size(0))
            preds.append(out.argmax(1).cpu().numpy())
            targets.append(y.cpu().numpy())
            
    if len(preds) > 0:
        preds = np.concatenate(preds)
        targets = np.concatenate(targets)
        loss = np.sum(losses) / len(loader.dataset)
        acc = accuracy_score(targets, preds)
        prec, rec, f1, _ = precision_recall_fscore_support(targets, preds, average='macro', zero_division=0)
    else:
        loss, acc, prec, rec, f1 = 0, 0, 0, 0, 0
        
    return {'loss': loss, 'acc': acc, 'f1_macro': f1, 'preds': preds, 'targets': targets}
