# Trial A: Fine-tune ResNet18
def adapt_resnet18_single_channel(num_classes, device):
    model = models.resnet18(weights=models.ResNet18_Weights.DEFAULT)
    w = model.conv1.weight.data
    if w.shape[1] != 1:
        new_w = w.mean(dim=1, keepdim=True)
        model.conv1 = nn.Conv2d(1, model.conv1.out_channels, kernel_size=model.conv1.kernel_size,
                                stride=model.conv1.stride, padding=model.conv1.padding, bias=(model.conv1.bias is not None))
        model.conv1.weight.data = new_w
    model.fc = nn.Linear(model.fc.in_features, num_classes)
    return model.to(device)

def train_trialA(train_loader, val_loader, test_loader, num_classes, class_names, device, args):
    model = adapt_resnet18_single_channel(num_classes, device)
    criterion = nn.CrossEntropyLoss()
    
    for name, param in model.named_parameters():
        if not name.startswith('fc'):
            param.requires_grad = False
            
    optimizer = torch.optim.Adam(filter(lambda p: p.requires_grad, model.parameters()), lr=args.base_lr, weight_decay=args.weight_decay)
    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='min', patience=3, factor=0.5)
    
    best_val_f1 = 0.0
    best_epoch = -1
    patience_counter = 0
    logs = []
    total_epochs = args.epochs_a
    
    for epoch in range(total_epochs):
        model.train()
        running_loss = 0.0
        all_preds, all_targets = [], []
        # Removed 'leave=False' to stop tqdm from overwriting lines
        for x, y in tqdm(train_loader, desc=f"TrialA Epoch {epoch+1}/{total_epochs}"):
            x, y = x.to(device), y.to(device)
            optimizer.zero_grad()
            out = model(x)
            loss = criterion(out, y)
            loss.backward()
            optimizer.step()
            
            running_loss += loss.item() * x.size(0)
            all_preds.append(out.argmax(1).cpu().numpy())
            all_targets.append(y.cpu().numpy())
            
        train_loss = running_loss / len(train_loader.dataset)
        train_preds = np.concatenate(all_preds)
        train_targets = np.concatenate(all_targets)
        train_acc = accuracy_score(train_targets, train_preds)
        
        val_res = evaluate_model(model, val_loader, device)
        scheduler.step(val_res['loss'])
        logs.append({'epoch': epoch+1, 'train_loss': train_loss, 'val_loss': val_res['loss'], 'train_acc': train_acc, 'val_acc': val_res['acc'], 'val_f1_macro': val_res['f1_macro']})
        print(f"\n>>> Epoch {epoch+1} Summary: Train Loss: {train_loss:.4f} | Val Loss: {val_res['loss']:.4f} | Val Acc: {val_res['acc']:.4f} | Val F1: {val_res['f1_macro']:.4f}\n")
        
        if epoch == 2:
            for name, param in model.named_parameters():
                param.requires_grad = True
            optimizer = torch.optim.Adam(model.parameters(), lr=args.backbone_lr, weight_decay=args.weight_decay)
            scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='min', patience=3, factor=0.5)
            print(">>> Unfroze all layers. Switched to backbone_lr.\n")
            
        if val_res['f1_macro'] > best_val_f1:
            best_val_f1 = val_res['f1_macro']
            best_epoch = epoch+1
            torch.save({'model_state': model.state_dict(), 'epoch': epoch+1, 'val_f1': best_val_f1}, '/kaggle/working/trialA_best.pth')
            patience_counter = 0
        else:
            patience_counter += 1
            
        if patience_counter >= 8:
            print("Early stopping Trial A triggered.\n")
            break
            
    df = pd.DataFrame(logs)
    df.to_csv('/kaggle/working/trialA_log.csv', index=False)
    
    best_ckpt = torch.load('/kaggle/working/trialA_best.pth', map_location=device)
    model.load_state_dict(best_ckpt['model_state'])
    test_res = evaluate_model(model, test_loader, device)
    
    cm = confusion_matrix(test_res['targets'], test_res['preds'])
    plt.figure(figsize=(8,6))
    plt.imshow(cm, interpolation='nearest', cmap=plt.cm.Blues)
    plt.title('Trial A Confusion Matrix')
    plt.colorbar()
    tick_marks = np.arange(num_classes)
    plt.xticks(tick_marks, class_names, rotation=45)
    plt.yticks(tick_marks, class_names)
    plt.ylabel('True label')
    plt.xlabel('Predicted label')
    plt.tight_layout()
    plt.savefig('/kaggle/working/trialA_confusion.png', dpi=200)
    plt.show()
    
    plt.figure()
    plt.plot(df['epoch'], df['train_loss'], label='train_loss')
    plt.plot(df['epoch'], df['val_loss'], label='val_loss')
    plt.xlabel('Epoch')
    plt.ylabel('Loss')
    plt.legend()
    plt.title('Trial A Loss Curves')
    plt.savefig('/kaggle/working/trialA_loss.png', dpi=200)
    plt.show()
    
    return {'best_epoch': best_epoch, 'best_val_f1': best_val_f1, 'best_val_acc': df.loc[df['epoch']==best_epoch,'val_acc'].values[0] if best_epoch>0 else None}
