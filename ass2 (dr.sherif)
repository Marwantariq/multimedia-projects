FRAME_MS   = 25
OVERLAP_MS = 10

def frame_signal(signal, rate, frame_ms=25, overlap_ms=10):
    frame_len  = int(rate * frame_ms  / 1000)
    step_len   = int(rate * (frame_ms - overlap_ms) / 1000)
    n_frames   = 1 + (len(signal) - frame_len) // step_len
    frames = np.array([
        signal[i * step_len : i * step_len + frame_len]
        for i in range(n_frames)
    ])
    return frames, frame_len, step_len

frames_v, flen_v, step_v = frame_signal(signal_v, rate_v, FRAME_MS, OVERLAP_MS)
frames_n, flen_n, step_n = frame_signal(signal_n, rate_n, FRAME_MS, OVERLAP_MS)

