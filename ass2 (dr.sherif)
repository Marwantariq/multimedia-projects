def maybe_convert_mp3_to_wav(path):
    if path.lower().endswith(".mp3"):
        wav_path = path[:-4] + "_converted.wav"
        if not os.path.exists(wav_path):
            print(f"Converting MP3 -> WAV: {wav_path}")
            subprocess.run([
                "ffmpeg", "-i", path,
                "-ac", "1", "-ar", "22050",
                wav_path, "-y"
            ], check=True)
        return wav_path
    return path

nonvoice_path = maybe_convert_mp3_to_wav(nonvoice_path)

def load_wav(path):
    rate, data = wav.read(path)
    if data.ndim > 1:
        data = data[:, 0]
    data = data.astype(np.float64)
    max_val = np.max(np.abs(data))
    if max_val > 0:
        data = data / max_val
    return rate, data

