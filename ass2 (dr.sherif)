def apply_window(frames, window_type="hamming"):
    flen = frames.shape[1]
    w = np.hamming(flen) if window_type == "hamming" else np.hanning(flen)
    return frames * w

frames_v_hamming = apply_window(frames_v, "hamming")
frames_v_hanning = apply_window(frames_v, "hanning")
frames_n_hamming = apply_window(frames_n, "hamming")
frames_n_hanning = apply_window(frames_n, "hanning")

print("\n  Hamming window applied to both files")
print("  Hanning window applied to both files")

frames_v_w = frames_v_hamming
frames_n_w = frames_n_hamming


def zero_crossing_rate(frames):
    signs = np.sign(frames)
    
    signs[signs == 0] = 1
    return np.sum(np.abs(np.diff(signs, axis=1)), axis=1) / (2 * frames.shape[1])

def short_time_energy(frames):
    return np.sum(frames ** 2, axis=1) / frames.shape[1]

zcr_v = zero_crossing_rate(frames_v_w)
zcr_n = zero_crossing_rate(frames_n_w)
ste_v = short_time_energy(frames_v_w)
