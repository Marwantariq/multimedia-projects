import os
os.environ.pop('SSLKEYLOGFILE', None)
os.environ['TF_ENABLE_ONEDNN_OPTS'] = '0'
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.gridspec as gridspec

SEED = 42
np.random.seed(SEED)

import tensorflow as tf
tf.random.set_seed(SEED)

from tensorflow import keras
from tensorflow.keras import layers, regularizers
from tensorflow.keras.callbacks import EarlyStopping, ReduceLROnPlateau


print("Loading CIFAR-10 ...")
(X_train_full, y_train_full), (X_test, y_test) = keras.datasets.cifar10.load_data()

CLASS_NAMES = ["airplane","automobile","bird","cat","deer",
               "dog","frog","horse","ship","truck"]

X_train_full = X_train_full.astype("float32") / 255.0
X_test       = X_test.astype("float32")       / 255.0

mean = X_train_full.mean(axis=(0,1,2), keepdims=True)
std  = X_train_full.std (axis=(0,1,2), keepdims=True) + 1e-7

X_train_full = (X_train_full - mean) / std
X_test       = (X_test       - mean) / std

val_size = 5000
X_val,   y_val   = X_train_full[:val_size],  y_train_full[:val_size]
X_train, y_train = X_train_full[val_size:],  y_train_full[val_size:]

print(f"  Train : {X_train.shape[0]:,}   Val : {X_val.shape[0]:,}   Test : {X_test.shape[0]:,}")

def build_model(input_shape=(32, 32, 3), num_classes=10):
    wd = 1e-4

    inp = keras.Input(shape=input_shape)

    x = layers.Conv2D(32, 3, padding="same",
                      kernel_regularizer=regularizers.l2(wd), use_bias=False)(inp)
    x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)

    x = layers.DepthwiseConv2D(3, padding="same", use_bias=False)(x)
    x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)
    x = layers.Conv2D(64, 1, use_bias=False)(x)
    x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)
    x = layers.MaxPooling2D(2)(x)
    x = layers.Dropout(0.2)(x)

    x = layers.DepthwiseConv2D(3, padding="same", use_bias=False)(x)
    x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)
    x = layers.Conv2D(128, 1, use_bias=False)(x)
    x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)
    x = layers.MaxPooling2D(2)(x)
    x = layers.Dropout(0.2)(x)

    x = layers.DepthwiseConv2D(3, padding="same", use_bias=False)(x)
    x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)
    x = layers.Conv2D(256, 1, use_bias=False)(x)
    x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)
    x = layers.Dropout(0.3)(x)

    x = layers.GlobalAveragePooling2D()(x)
    x = layers.Dense(128, activation="relu",
                     kernel_regularizer=regularizers.l2(wd))(x)
    x = layers.Dropout(0.4)(x)
    out = layers.Dense(num_classes, activation="softmax")(x)

    return keras.Model(inp, out, name="CompactCNN")

model = build_model()
model.summary()
print(f"\n  Total parameters : {model.count_params():,}")

EPOCHS     = 70
BATCH_SIZE = 128

model.compile(
    optimizer=keras.optimizers.Adam(learning_rate=1e-3),
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"],
)

callbacks = [
    EarlyStopping(monitor="val_accuracy", patience=15,
                  restore_best_weights=True, verbose=1),
    ReduceLROnPlateau(monitor="val_loss", factor=0.5, patience=5,
                      min_lr=1e-6, verbose=1),
]

print("\nTraining ...")

train_ds = tf.data.Dataset.from_tensor_slices((X_train, y_train))
train_ds = train_ds.shuffle(len(X_train), seed=SEED).batch(BATCH_SIZE)
train_ds = train_ds.map(
    lambda x, y: (tf.image.random_flip_left_right(x), y),
    num_parallel_calls=tf.data.AUTOTUNE
).prefetch(tf.data.AUTOTUNE)

history = model.fit(
    train_ds,
    epochs=EPOCHS,
    validation_data=(X_val, y_val),
    callbacks=callbacks,
    verbose=1,
)

train_loss, train_acc = model.evaluate(X_train, y_train, verbose=0)
val_loss,   val_acc   = model.evaluate(X_val,   y_val,   verbose=0)
test_loss,  test_acc  = model.evaluate(X_test,  y_test,  verbose=0)

print("\n" + "="*50)
print(f"  Train  - Loss: {train_loss:.4f}  |  Accuracy: {train_acc*100:.2f}%")
print(f"  Val    - Loss: {val_loss:.4f}  |  Accuracy: {val_acc*100:.2f}%")
print(f"  Test   - Loss: {test_loss:.4f}  |  Accuracy: {test_acc*100:.2f}%")
print("="*50)

epochs_ran  = range(1, len(history.history["loss"]) + 1)
best_ep     = np.argmax(history.history["val_accuracy"]) + 1
train_acc_h = history.history["accuracy"]
val_acc_h   = history.history["val_accuracy"]

C_TRAIN = "#2196F3"
C_VAL   = "#FF9800"
C_TEST  = "#4CAF50"
ALPHA   = 0.15

fig = plt.figure(figsize=(16, 10))
fig.patch.set_facecolor("#0F1117")
gs  = gridspec.GridSpec(2, 2, figure=fig,
                        hspace=0.40, wspace=0.30,
                        left=0.07, right=0.97, top=0.88, bottom=0.08)

ax_loss = fig.add_subplot(gs[0, 0])
ax_acc  = fig.add_subplot(gs[0, 1])
ax_bar  = fig.add_subplot(gs[1, 0])
ax_cls  = fig.add_subplot(gs[1, 1])

for ax in [ax_loss, ax_acc, ax_bar, ax_cls]:
    ax.set_facecolor("#1A1D27")
    for spine in ax.spines.values():
        spine.set_edgecolor("#3A3D4D")
    ax.tick_params(colors="#CCCCCC", labelsize=9)
    ax.xaxis.label.set_color("#CCCCCC")
    ax.yaxis.label.set_color("#CCCCCC")
    ax.title.set_color("#FFFFFF")

ax_loss.plot(epochs_ran, history.history["loss"],     color=C_TRAIN, lw=2, label="Train")
ax_loss.plot(epochs_ran, history.history["val_loss"], color=C_VAL,   lw=2, label="Val")
ax_loss.axhline(test_loss, color=C_TEST, lw=1.8, ls="--", label=f"Test ({test_loss:.3f})")
ax_loss.axvline(best_ep,   color="#888", lw=1,   ls=":",  alpha=0.7, label=f"Best epoch ({best_ep})")
ax_loss.fill_between(epochs_ran,
                     history.history["loss"],
                     history.history["val_loss"],
                     alpha=ALPHA, color=C_VAL)
ax_loss.set_title("Loss - Train / Val / Test", fontsize=12, fontweight="bold")
ax_loss.set_xlabel("Epoch")
ax_loss.set_ylabel("Loss")
ax_loss.legend(fontsize=9, facecolor="#2A2D37", labelcolor="#CCCCCC")
ax_loss.grid(True, color="#2A2D37", lw=0.6)

ax_acc.plot(epochs_ran, [v*100 for v in train_acc_h], color=C_TRAIN, lw=2, label="Train")
ax_acc.plot(epochs_ran, [v*100 for v in val_acc_h],   color=C_VAL,   lw=2, label="Val")
ax_acc.axhline(test_acc*100, color=C_TEST, lw=1.8, ls="--",
               label=f"Test ({test_acc*100:.2f}%)")
ax_acc.axvline(best_ep, color="#888", lw=1, ls=":", alpha=0.7, label=f"Best epoch ({best_ep})")
ax_acc.fill_between(epochs_ran,
                    [v*100 for v in train_acc_h],
                    [v*100 for v in val_acc_h],
                    alpha=ALPHA, color=C_VAL)
ax_acc.set_title("Accuracy - Train / Val / Test", fontsize=12, fontweight="bold")
ax_acc.set_xlabel("Epoch")
ax_acc.set_ylabel("Accuracy (%)")
ax_acc.legend(fontsize=9, facecolor="#2A2D37", labelcolor="#CCCCCC")
ax_acc.grid(True, color="#2A2D37", lw=0.6)

labels = ["Train", "Val", "Test"]
accs   = [train_acc*100, val_acc*100, test_acc*100]
colors = [C_TRAIN, C_VAL, C_TEST]
bars   = ax_bar.bar(labels, accs, color=colors, width=0.5, edgecolor="#3A3D4D")
for bar, v in zip(bars, accs):
    ax_bar.text(bar.get_x() + bar.get_width()/2, v + 0.4,
                f"{v:.2f}%", ha="center", va="bottom",
                color="#FFFFFF", fontsize=11, fontweight="bold")
ax_bar.set_ylim(0, 110)
ax_bar.set_title("Final Accuracy Summary", fontsize=12, fontweight="bold")
ax_bar.set_ylabel("Accuracy (%)")
ax_bar.grid(True, axis="y", color="#2A2D37", lw=0.6)

y_pred      = np.argmax(model.predict(X_test, verbose=0), axis=1)
y_true_flat = y_test.flatten()
per_class   = [(y_pred[y_true_flat == c] == c).mean() * 100 for c in range(10)]
bar_colors  = plt.cm.RdYlGn([v/100 for v in per_class])

b2 = ax_cls.barh(CLASS_NAMES, per_class, color=bar_colors, edgecolor="#3A3D4D")
for bar, v in zip(b2, per_class):
    ax_cls.text(v + 0.5, bar.get_y() + bar.get_height()/2,
                f"{v:.1f}%", va="center", color="#FFFFFF", fontsize=9)
ax_cls.set_xlim(0, 108)
ax_cls.set_title("Per-Class Test Accuracy", fontsize=12, fontweight="bold")
ax_cls.set_xlabel("Accuracy (%)")
ax_cls.grid(True, axis="x", color="#2A2D37", lw=0.6)

fig.suptitle(
    f"CIFAR-10 Compact CNN  |  Params: {model.count_params():,}  "
    f"|  Best Val: {max(val_acc_h)*100:.2f}%  "
    f"|  Test: {test_acc*100:.2f}%",
    color="#FFFFFF", fontsize=13, fontweight="bold", y=0.96
)

script_dir = os.path.dirname(os.path.abspath(__file__))
out_path   = os.path.join(script_dir, "ass2_cnn_cifar10_results.png")
plt.savefig(out_path, dpi=150, bbox_inches="tight", facecolor=fig.get_facecolor())
print(f"\nPlot saved -> {out_path}")
plt.show()
